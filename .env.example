# AI & External APIs
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Storage (Supabase)
VITE_SUPABASE_URL=https://iheyjovfbmrgwuswoatl.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Robokassa Acquiring Settings
# Merchant Login from Robokassa Cabinet (Идентификатор магазина)
ROBOKASSA_MERCHANT_LOGIN=sparta_sports
# Production Passwords (Пароль 1 - для генерации ссылок, Пароль 2 - для проверки результатов)
ROBOKASSA_PASSWORD_1=your_production_password_1
ROBOKASSA_PASSWORD_2=your_production_password_2

# Test Mode Flag (true = тестовый режим, false = боевой прием платежей)
IS_TEST_MODE=false
# Test Passwords (Тестовый пароль 1 и 2 из ЛК Robokassa)
ROBOKASSA_TEST_PASSWORD_1=your_test_password_1
ROBOKASSA_TEST_PASSWORD_2=your_test_password_2

# YooKassa (Alternative)
VITE_YOOKASSA_SHOP_ID=your_shop_id
VITE_YOOKASSA_SECRET_KEY=your_secret_key

# Socials (VK News sync)
VITE_VK_ACCESS_TOKEN=your_vk_token
