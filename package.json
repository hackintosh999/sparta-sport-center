{
    "name": "sparta-sports-center",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "concurrently \"vite\" \"node server.js\"",
        "build": "tsc --noEmit && vite build",
        "lint": "eslint \"{components,hooks,utils,types,context,scripts,.}/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"{components,hooks,utils,types,context,scripts,.}/**/*.{ts,tsx}\" --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
        "seed": "node scripts/seed_students_from_lists.ts",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
        "electron:build": "npm run build && electron-builder",
        "android:add": "npx cap add android",
        "android:sync": "npm run build && npx cap sync android",
        "android:open": "npx cap open android"
    },
    "build": {
        "appId": "com.sparta.sports",
        "productName": "SPARTA Sports Center",
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "directories": {
            "output": "release"
        }
    },
    "dependencies": {
        "@capacitor/android": "^8.3.0",
        "@capacitor/cli": "^8.3.0",
        "@capacitor/core": "^8.3.0",
        "@google/generative-ai": "^0.24.1",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.5.0",
        "@supabase/supabase-js": "^2.95.3",
        "@types/canvas-confetti": "^1.9.0",
        "@types/express": "^5.0.6",
        "@types/http-proxy-middleware": "^0.19.3",
        "@types/three": "^0.182.0",
        "canvas-confetti": "^1.9.4",
        "concurrently": "^9.2.1",
        "cors": "^2.8.6",
        "date-fns": "^4.1.0",
        "dotenv": "^17.3.1",
        "emoji-picker-react": "^4.17.4",
        "express": "^5.2.1",
        "firebase": "^12.8.0",
        "formidable": "^3.5.1",
        "framer-motion": "^12.30.0",
        "gsap": "^3.15.0",
        "headroom-ai": "^0.22.4",
        "html2canvas": "^1.4.1",
        "html5-qrcode": "^2.3.8",
        "http-proxy-middleware": "^3.0.5",
        "jspdf": "^4.2.0",
        "jspdf-autotable": "^5.0.7",
        "lottie-react": "^2.4.1",
        "lucide-react": "^0.563.0",
        "multer": "^2.1.1",
        "puppeteer": "^25.5.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-player": "^3.4.0",
        "react-router-dom": "^7.13.0",
        "recharts": "^3.7.0",
        "three": "^0.182.0",
        "uuid": "^13.0.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^22.14.0",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "@vitejs/plugin-react": "^5.0.0",
        "autoprefixer": "^10.5.4",
        "electron": "^41.1.1",
        "electron-builder": "^26.8.1",
        "electron-is-dev": "^3.0.1",
        "electron-serve": "^3.0.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.5.0",
        "postcss": "^8.5.25",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "typescript-eslint": "^8.59.0",
        "vite": "^6.2.0",
        "wait-on": "^9.0.4"
    }
}
